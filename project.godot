; Engine configuration file.
; Beach Rake / "Seaweed Shift" prototype

config_version=5

[application]

config/name="Seaweed Shift"
run/main_scene="res://scenes/menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="canvas_items"
# "keep", not "expand". The whole game is built around an exact 360x640 canvas:
# zone boundaries at y=190/420/530, a HUD strip pinned to y=598, a water strip
# at y=392. "expand" hands a tall phone a 360x800 viewport, so every one of
# those numbers points at the wrong place -- the menu water strip landed on top
# of the resort, and the beach background stopped 160px short of the bottom.
# "keep" letterboxes instead, which preserves the design exactly.
window/stretch/aspect="keep"
window/handheld/orientation=1

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
